# WalletConnect Cloud project id — create one free at https://cloud.reown.com
# Required for WalletConnect / mobile wallets (Trust Wallet mobile, MetaMask mobile, ...).
VITE_WALLETCONNECT_PROJECT_ID=

# Deployed contract addresses on DogeOS Chikyū Testnet (chain 6281971).
# Optional overrides. IdentityRegistry is already recorded in src/lib/config.ts
# (0x007583D5B15A9B8ac928FD64460aD97866c5c947). Empty = use the recorded deployment.
VITE_IDENTITY_REGISTRY_ADDRESS=
VITE_SAVINGS_VAULT_ADDRESS=

# Client-safe public key only (never service_role)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Official DogeOS SDK client ID — requires project registration at sdk.dogeos.com
VITE_DOGEOS_CLIENT_ID=
